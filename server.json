{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.giacomomaria81/scorm-mcp-server",
  "title": "SCORM Packager (HTML → SCORM 2004)",
  "description": "Turn HTML or mobile-learning exports into SCORM 2004/1.2 packages, and validate any SCORM zip.",
  "version": "2.3.0",
  "websiteUrl": "https://github.com/giacomomaria81/scorm-mcp-server#readme",
  "repository": {
    "url": "https://github.com/giacomomaria81/scorm-mcp-server",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "scorm-mcp-server",
      "version": "2.3.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SCORM_OUTPUT_DIR",
          "description": "Absolute path of the folder where generated SCORM .zip packages are written. Defaults to the current working directory.",
          "isRequired": false,
          "isSecret": false,
          "format": "filepath"
        }
      ]
    },
    {
      "registryType": "mcpb",
